# porta HTTP que a API vai usar a partir do M2
PORT=
# modo de execução
NODE_ENV=
# URL do banco que o db:migrate migra, sem senha: postgres://<usuário>@<host>:<porta>/<banco>
# O alvo sai do host: localhost é o local, e os poolers do Supabase são o dev e o prod
MIGRATION_DATABASE_URL=
# senha do usuário de MIGRATION_DATABASE_URL, crua, sem codificação
MIGRATION_DATABASE_PASSWORD=
# diretório absoluto, fora do repositório, onde o db:migrate grava a exportação do prod
PROD_DUMP_DIR=
# URL sem senha do Postgres de teste, como postgres, em localhost
TEST_DATABASE_URL=
# senha do Postgres de teste
TEST_DATABASE_PASSWORD=
